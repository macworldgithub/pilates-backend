{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{dist/**,public/images/**,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/media/images/:path*", "destination": "/images/:path*" },
    { "source": "/:path*", "destination": "/api/index" }
  ]
}
