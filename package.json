{
  "name": "project-orbit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS / Express / MongoDB API for the Project Orbit simulated MVP",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "dev": "npm run start:dev",
    "seed": "npm run build && node dist/seed.js",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "vercel-build": "npm run build",
    "verify:deployed": "node scripts/verify-deployed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "mongoose": "^8.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
