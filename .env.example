NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pilates
# Generate a private token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Optional direct API-client token; minimum 32 characters if set. Mobile admin uses username/password login.
ADMIN_TOKEN=
# Comma-separated exact browser origins; native mobile clients do not need CORS.
CORS_ORIGINS=http://localhost:8081
SESSION_TTL_DAYS=30
